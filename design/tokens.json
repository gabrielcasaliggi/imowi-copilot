{
  "$description": "Fuente única de verdad del sistema visual Eko (app y web). No editar los archivos generados: correr `node scripts/design-tokens.mjs`.",
  "color": {
    "bg": { "light": "#F3F7F8", "dark": "#0A1120" },
    "surface": { "light": "#FFFFFF", "dark": "#121B2D" },
    "nav": { "light": "#FFFFFF", "dark": "#0D1627" },
    "border": { "light": "#DCE6E9", "dark": "#22304A" },
    "borderStrong": { "light": "#748890", "dark": "#62728C" },
    "ink": { "light": "#0E1F26", "dark": "#E8EEF7" },
    "muted": { "light": "#566A72", "dark": "#93A3BC" },
    "primary": { "light": "#0E6B78", "dark": "#3DD6C3" },
    "onPrimary": { "light": "#FFFFFF", "dark": "#04201C" },
    "ok": { "light": "#1F7A4D", "dark": "#4ADE9A" },
    "okSoft": { "light": "#E3F4EA", "dark": "#12301F" },
    "warn": { "light": "#8A4B00", "dark": "#F2B84B" },
    "warnSoft": { "light": "#FFF0D6", "dark": "#2B2412" },
    "danger": { "light": "#B42318", "dark": "#F87171" },
    "dangerSoft": { "light": "#FDECEA", "dark": "#2D1518" },
    "ring": { "light": "#0E8A93", "dark": "#3DD6C3" },
    "track": { "light": "#DCE6E9", "dark": "#22304A" },
    "disabled": { "light": "#DCE6E9", "dark": "#22304A" },
    "onDisabled": { "light": "#566A72", "dark": "#93A3BC" }
  },
  "font": {
    "family": "Manrope",
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700, "extrabold": 800 },
    "size": {
      "xs": 12,
      "sm": 13,
      "md": 14,
      "base": 15,
      "lg": 16,
      "xl": 17,
      "title": 22,
      "headline": 26,
      "display": 30,
      "hero": 36
    },
    "bodyMin": 13
  },
  "radius": { "control": 14, "card": 18, "cardLg": 24, "pill": 999 },
  "space": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "xxl": 32, "xxxl": 40 },
  "size": { "hit": 44, "maxContent": 480 },
  "contrast": {
    "threshold": { "text": 4.5, "large": 3, "graphic": 3, "disabled": 3 },
    "pairs": [
      { "fg": "ink", "bg": "bg", "use": "text" },
      { "fg": "ink", "bg": "surface", "use": "text" },
      { "fg": "ink", "bg": "nav", "use": "text" },
      { "fg": "muted", "bg": "bg", "use": "text" },
      { "fg": "muted", "bg": "surface", "use": "text" },
      { "fg": "muted", "bg": "nav", "use": "text" },
      { "fg": "primary", "bg": "bg", "use": "text" },
      { "fg": "primary", "bg": "surface", "use": "text" },
      { "fg": "primary", "bg": "nav", "use": "text" },
      { "fg": "onPrimary", "bg": "primary", "use": "text" },
      { "fg": "ok", "bg": "surface", "use": "text" },
      { "fg": "ok", "bg": "okSoft", "use": "text" },
      { "fg": "ink", "bg": "okSoft", "use": "text" },
      { "fg": "warn", "bg": "surface", "use": "text" },
      { "fg": "warn", "bg": "warnSoft", "use": "text" },
      { "fg": "ink", "bg": "warnSoft", "use": "text" },
      { "fg": "danger", "bg": "bg", "use": "text" },
      { "fg": "danger", "bg": "surface", "use": "text" },
      { "fg": "danger", "bg": "dangerSoft", "use": "text" },
      { "fg": "ink", "bg": "dangerSoft", "use": "text" },
      { "fg": "borderStrong", "bg": "surface", "use": "graphic" },
      { "fg": "borderStrong", "bg": "bg", "use": "graphic" },
      { "fg": "ring", "bg": "bg", "use": "graphic" },
      { "fg": "ring", "bg": "surface", "use": "graphic" },
      { "fg": "ring", "bg": "track", "use": "graphic" },
      { "fg": "primary", "bg": "track", "use": "graphic" },
      { "fg": "ok", "bg": "track", "use": "graphic" },
      { "fg": "warn", "bg": "track", "use": "graphic" },
      { "fg": "danger", "bg": "track", "use": "graphic" },
      { "fg": "onDisabled", "bg": "disabled", "use": "disabled" }
    ]
  }
}
