[Unit]
Description=Operations Hub API (FastAPI)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=__APP_USER__
Group=__APP_USER__
WorkingDirectory=__APP_ROOT__
EnvironmentFile=__APP_ROOT__/.env
Environment=HOST=127.0.0.1
Environment=PORT=8000
ExecStart=__APP_ROOT__/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
