# Copiar a scripts/deploy.env (ignorado por git) y ajustar. Sin secretos: SSH por clave
# (ssh-agent / ~/.ssh/config con el alias "eko-server").
DEPLOY_HOST=eko-server
DEPLOY_USER=soporte
DEPLOY_PATH=/opt/operations-hub
DEPLOY_BRANCH=main
DEPLOY_RESTART_CMD="sudo systemctl restart operations-hub-api"
DEPLOY_SERVICE=operations-hub-api
DEPLOY_HEALTH_URL=            # opcional. Propuesta: https://ibot.ecolan.com/health (main.py:200, nginx location /health)

# Opcionales
# DEPLOY_BACKUP_CMD="sudo bash scripts/backup-estate.sh"   # DEPLOY.md paso 1; se corre en DEPLOY_PATH antes del pull
# DEPLOY_SSH_TTY=1                                          # usar ssh -t (si sudo pide contraseña)
