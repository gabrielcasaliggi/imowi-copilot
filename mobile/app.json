{
  "expo": {
    "name": "EKO-Asistente",
    "slug": "soporte-batan",
    "version": "1.0.7",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "scheme": "soportebatan",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F3F7F8"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "coop.batan.soporte",
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#F3F7F8",
        "dark": {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0A1120"
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2298A6"
      },
      "package": "coop.batan.soporte",
      "googleServicesFile": "./google-services.json",
      "versionCode": 16,
      "softwareKeyboardLayoutMode": "resize",
      "edgeToEdgeEnabled": false,
      "blockedPermissions": [
        "com.google.android.gms.permission.AD_ID"
      ],
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#F3F7F8",
        "dark": {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0A1120"
        }
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2298A6",
          "defaultChannel": "eko"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "EKO usa el micrófono para enviar mensajes de voz a Eko."
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Manrope_400Regular.ttf",
            "./assets/fonts/Manrope_500Medium.ttf",
            "./assets/fonts/Manrope_600SemiBold.ttf",
            "./assets/fonts/Manrope_700Bold.ttf",
            "./assets/fonts/Manrope_800ExtraBold.ttf"
          ]
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://ibot.ecolan.com",
      "orgSlug": "coop-batan",
      "privacyUrl": "https://ibot.ecolan.com/privacidad",
      "eas": {
        "projectId": "1256fca1-cf0c-4567-9317-b6338cd97d44"
      }
    },
    "owner": "gabrielcasaliggi"
  }
}
