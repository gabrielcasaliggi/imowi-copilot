{
  "expo": {
    "name": "EKO-Asistente",
    "slug": "soporte-batan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "soportebatan",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1220"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "coop.batan.soporte",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Eko usa el micrófono para que puedas consultar por voz.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2298A6"
      },
      "package": "coop.batan.soporte",
      "versionCode": 2,
      "permissions": [
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2298A6",
          "sounds": [],
          "defaultChannel": "eko"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Eko usa el micrófono para que puedas consultar por voz."
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://ibot.ecolan.com",
      "orgSlug": "coop-batan",
      "eas": {
        "projectId": "1256fca1-cf0c-4567-9317-b6338cd97d44"
      }
    },
    "owner": "gabrielcasaliggi"
  }
}
