# LLM — desarrollo local (Ollama)
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=ollama
AI_MODEL=llama3.2

# LLM — producción (Groq u otro compatible OpenAI)
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_API_KEY=
# AI_MODEL=llama-3.3-70b-versatile

# Entorno: development | production
APP_ENV=development

# Auth JWT (obligatorio en producción — generá uno: openssl rand -hex 32)
# AUTH_SECRET=
# PORTAL_AUTH_SECRET=   # distinto de AUTH_SECRET
AUTH_TOKEN_HOURS=12
# DISABLE_DEMO_USERS=true
# PORTAL_AUTH_MODE=dni_otp
# PORTAL_ALLOW_GUEST=true

# SMTP (invites + OTP portal)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# PUBLIC_URL=http://localhost:3000

# Branding — asistente abonado (N1). Distinct from Copilot NOC.
# BOT_DISPLAY_NAME=Eco
# BOT_DISPLAY_NAME_SHORT=ECO
# PRODUCT_DISPLAY_NAME=Soporte Batán
# Dominio futuro de marca: soporte.batan.coop (hoy prod: ibot.ecolan.com)

# Usuarios demo (solo development — desactivados en production)
# ADMIN_USER=admin
# ADMIN_PASSWORD=cambiar-en-produccion
# COOP_USER=coop_prueba
# COOP_PASSWORD=cambiar-en-produccion
# COOP_NOMBRE=Operador Prueba
# COOP_COOPERATIVA=Cooperativa Prueba
# MOCK_USERS_JSON={"mi_coop":{"password":"xxx","rol":"cooperativa","cooperativa":"Coop X","nombre":"Operador"}}

# Data Estate — SQLite local (dev) o PostgreSQL Supabase (producción)
# (tickets, config, canal, KB — NO es el padrón BillTrack de clientes)
# DATABASE_URL=sqlite:///./data/estate.db
# Producción (Supabase → Settings → Database → Connection string → URI, modo Transaction pooler):
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-xx.pooler.supabase.com:6543/postgres
# DATABASE_SSLMODE=require

# BillTrack — Postgres externo de solo lectura (padrón de clientes)
# BILLTRACK_ENABLED=true
# BILLTRACK_LOOKUP_READY=true
# BILLTRACK_HOST=
# BILLTRACK_PORT=5432
# BILLTRACK_USER=billtrack_reader
# BILLTRACK_PASSWORD=
# BILLTRACK_DBNAME=postgres
# BILLTRACK_SSLMODE=require
# BILLTRACK_LOOKUP_SQL=SELECT id AS ref, email, telefono, estado AS activo, nombre FROM clientes WHERE dni = :dni LIMIT 1
# BILLTRACK_DATABASE_URL=postgresql://billtrack_reader:PASSWORD@host:5432/dbname

# Supabase REST — espejo legacy de tickets (opcional si DATABASE_URL ya es el mismo Postgres)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_KEY=eyJ...   # service_role — SOLO backend

# CORS — orígenes del frontend (sin barra final, separados por coma)
# Dev Next.js: http://localhost:3000
# CORS_ORIGINS=http://localhost:3000,https://tu-app.vercel.app

# Frontend Next.js (separado del backend)
# NEXT_PUBLIC_API_URL=http://localhost:8000

# RAG — búsqueda por keywords (no inyectar KB completa; evita 413 en Groq)
# KNOWLEDGE_MIN_SCORE=0.15
# KNOWLEDGE_TOP_K=1
# KNOWLEDGE_MAX_FRAGMENT_CHARS=1800
# KNOWLEDGE_MAX_SYSTEM_TOKENS=4500

# Persistencia JSON local (solo dev sin Supabase)
# DATA_DIR=./data

# Frontend Netlify (build) — URL pública de la API en Render
# IMOWI_API_URL=https://imowi-copilot-api.onrender.com

# WhatsApp Cloud API (Meta) — canal abonado
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=ops-hub-wa-verify
# WHATSAPP_APP_SECRET=
# WHATSAPP_DEFAULT_ORG_SLUG=coop-batan

# Servidor local
# HOST=0.0.0.0
# PORT=8000
