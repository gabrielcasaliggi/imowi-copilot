# LLM — desarrollo local (Ollama)
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=ollama
AI_MODEL=llama3.2

# LLM — producción (Groq u otro compatible OpenAI)
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_API_KEY=
# AI_MODEL=llama-3.3-70b-versatile

# Entorno: development | production
APP_ENV=development
# Solo rescate: permite arrancar production con config insegura (NO usar en Batán normal)
# ALLOW_INSECURE_PROD=false

# Auth JWT (obligatorio en producción — generá uno: openssl rand -hex 32)
# AUTH_SECRET=
# PORTAL_AUTH_SECRET=   # distinto de AUTH_SECRET (≥32 chars)
AUTH_TOKEN_HOURS=12
# DISABLE_DEMO_USERS=true
# PORTAL_AUTH_MODE=dni_otp
# Guest anónimo: en production queda off si no seteás la var.
# PORTAL_ALLOW_GUEST=true
# API docs (/docs) y Copilot HTML legacy: off en production por defecto
# ENABLE_API_DOCS=true
# ENABLE_LEGACY_API=true

# SMTP (invites + OTP portal)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# PUBLIC_URL=http://localhost:3000

# Branding — asistente abonado (N1). Distinct from Copilot NOC.
# BOT_DISPLAY_NAME=Eko
# BOT_DISPLAY_NAME_SHORT=EKO
# PRODUCT_DISPLAY_NAME=Soporte Batán
# ASSISTANT_TAGLINE=Tu asistente virtual
# TICKET_ID_PREFIX=IBOT
# Consola: ibot.ecolan.com · portal público: soporte.ecolan.com

# Usuarios demo (solo development — desactivados en production)
# ADMIN_USER=admin
# ADMIN_PASSWORD=cambiar-en-produccion
# COOP_USER=coop_prueba
# COOP_PASSWORD=cambiar-en-produccion
# COOP_NOMBRE=Operador Prueba
# COOP_COOPERATIVA=Cooperativa Prueba
# MOCK_USERS_JSON={"mi_coop":{"password":"xxx","rol":"cooperativa","cooperativa":"Coop X","nombre":"Operador"}}

# Data Estate — SQLite local (dev) o PostgreSQL Supabase (producción)
# (tickets, config, canal, KB — NO es el padrón BillTrack de clientes)
# DATABASE_URL=sqlite:///./data/estate.db
# Producción (Supabase → Settings → Database → Connection string → URI, modo Transaction pooler):
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-xx.pooler.supabase.com:6543/postgres
# DATABASE_SSLMODE=require

# BillTrack — Postgres externo de solo lectura (padrón de clientes)
# BILLTRACK_ENABLED=true
# Con BillTrack habilitado en Admin (+ host/user/pass/dbname=billtrack, sslmode=disable)
# el portal/bot usa el SQL por defecto sobre api_person (CUIT contiene DNI).
# BILLTRACK_LOOKUP_READY=false  # fuerza apagar lookup real
# BILLTRACK_HOST=181.41.240.23
# BILLTRACK_PORT=5432
# BILLTRACK_USER=billtrack_reader
# BILLTRACK_PASSWORD=
# BILLTRACK_DBNAME=billtrack
# BILLTRACK_SSLMODE=disable
# Opcional: override del SELECT (placeholders :dni :org_slug :linea)
# BILLTRACK_LOOKUP_SQL=

# Radius / NAS API (sesión PPPoE para el bot)
# RADIUS_API_ENABLED=true
# RADIUS_API_BASE_URL=https://radius.api.batan.coop
# RADIUS_API_KEY=
# RADIUS_API_TOKEN=
# RADIUS_API_TIMEOUT=8

# UISP NMS (CPE radio — el nombre del dispositivo = username Radius)
# UISP_ENABLED=true
# UISP_BASE_URL=https://uisp.ecolan.com
# UISP_API_TOKEN=
# UISP_VERIFY_SSL=true
# UISP_TIMEOUT=12

# Supabase REST — espejo legacy de tickets (opcional si DATABASE_URL ya es el mismo Postgres)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_KEY=eyJ...   # service_role — SOLO backend

# CORS — orígenes del frontend (sin barra final, separados por coma)
# Dev Next.js: http://localhost:3000
# Prod: ambos hosts
# CORS_ORIGINS=http://localhost:3000,https://ibot.ecolan.com,https://soporte.ecolan.com

# Frontend Next.js (separado del backend)
# NEXT_PUBLIC_API_URL=http://localhost:8000

# RAG — dump markdown opcional (no se versiona). N1 usa KB tenant en Postgres.
# KNOWLEDGE_FILE=data/base_conocimiento.md
# KNOWLEDGE_MIN_SCORE=0.15
# KNOWLEDGE_TOP_K=1
# KNOWLEDGE_MAX_FRAGMENT_CHARS=1800
# KNOWLEDGE_MAX_SYSTEM_TOKENS=4500

# Persistencia JSON local (solo dev sin Supabase)
# DATA_DIR=./data

# Frontend Netlify (build) — URL pública de la API en Render
# IMOWI_API_URL=https://imowi-copilot-api.onrender.com

# WhatsApp Cloud API (Meta) — canal abonado
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=ops-hub-wa-verify
# WHATSAPP_APP_SECRET=
# WHATSAPP_DEFAULT_ORG_SLUG=coop-batan

# Telegram Bot API (opcional)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=ops-hub-tg-secret
# TELEGRAM_DEFAULT_ORG_SLUG=coop-batan

# Whisper STT — solo este servicio va en Docker; el backend sigue nativo
# Levantar: docker compose -f docker-compose.whisper.yml up -d --build
# WHISPER_ENABLED=true
# WHISPER_URL=http://localhost:9000
# WHISPER_TIMEOUT_S=30

# TTS — voz femenina argentina EN LA API (Edge es-AR-ElenaNeural)
# TTS_ENABLED=true
# TTS_BACKEND=edge
# TTS_VOICE=es-AR-ElenaNeural
# TTS_TIMEOUT_S=45
# Contenedor :9100 opcional: TTS_BACKEND=http + TTS_URL=http://127.0.0.1:9100
# Ver docs/ECO-TTS.md — NO uses Coqui css10 (español de España)

# Observabilidad (opcional) — Sentry
# Observabilidad (recomendado)
# SENTRY_DSN=https://...@sentry.io/...
# SENTRY_TRACES_SAMPLE_RATE=0.1
# Si aún no hay Sentry, documentá el riesgo:
# SENTRY_RISK_ACCEPTED=true
# Frontend: NEXT_PUBLIC_SENTRY_DSN=... (requiere @sentry/browser)

# Servidor local
# HOST=0.0.0.0
# PORT=8000
