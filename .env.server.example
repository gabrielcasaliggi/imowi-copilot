# Plantilla para despliegue NATIVO en Ubuntu 24.04 — ibot.ecolan.com
# El instalador (scripts/install-server.sh) copia esto a .env si no existe.
#
#   sudo bash scripts/install-server.sh --domain ibot.ecolan.com --email admin@ecolan.com

# ── Dominio / HTTPS ─────────────────────────────────────────────────────────
DOMAIN=ibot.ecolan.com
PUBLIC_URL=https://ibot.ecolan.com
CORS_ORIGINS=https://ibot.ecolan.com
HTTP_PORT=80
# LETSENCRYPT_EMAIL=admin@ecolan.com

# ── PostgreSQL local (Data Estate) ──────────────────────────────────────────
POSTGRES_USER=ops_hub
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_FUERTE
POSTGRES_DB=ops_hub

# El instalador escribe DATABASE_URL automáticamente:
# DATABASE_URL=postgresql://ops_hub:PASSWORD@127.0.0.1:5432/ops_hub
# DATABASE_SSLMODE=disable

# ── App ─────────────────────────────────────────────────────────────────────
APP_ENV=production
HOST=127.0.0.1
PORT=8000
# openssl rand -hex 32
AUTH_SECRET=
# Distinto de AUTH_SECRET (openssl rand -hex 32)
PORTAL_AUTH_SECRET=
AUTH_TOKEN_HOURS=12
PORTAL_TOKEN_HOURS=4
CONSOLE_JWT_AUD=ops-hub-console
PORTAL_JWT_AUD=ops-hub-portal
DISABLE_DEMO_USERS=true
PORTAL_AUTH_MODE=dni_otp

# Branding — asistente abonado (canal N1 / portal / WhatsApp)
# Producto abonado: Soporte Batán. Consola ops: Operations Hub / Copilot NOC.
BOT_DISPLAY_NAME=Eco
BOT_DISPLAY_NAME_SHORT=ECO
PRODUCT_DISPLAY_NAME=Soporte Batán
TICKET_ID_PREFIX=IBOT
# Dominio prod actual: ibot.ecolan.com — futuro de marca: soporte.batan.coop (ver docs/ECO-VOICE.md)
PORTAL_ALLOW_GUEST=true

# Admin inicial (solo seed en DB vacía — luego invite)
ADMIN_EMAIL=admin@ecolan.com
ADMIN_PASSWORD=CAMBIAR_ADMIN_FUERTE_Min10
ADMIN_NOMBRE=Administración

# ── SMTP (invites consola + OTP portal) ─────────────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@ecolan.com
# SMTP_TLS=true
# SMTP_SSL=false

# ── OTP portal ──────────────────────────────────────────────────────────────
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_WINDOW_MINUTES=15
AUTH_LOCKOUT_MINUTES=30
# DNI_PEPPER=  # opcional; default AUTH_SECRET

# ── LLM en servidor aparte (compatible OpenAI) ──────────────────────────────
AI_BASE_URL=http://IP_DEL_SERVIDOR_LLM:11434/v1
AI_API_KEY=ollama
AI_MODEL=llama3.2

# ── BillTrack (SOLO LECTURA — padrón) ───────────────────────────────────────
# BILLTRACK_ENABLED=true
# BILLTRACK_LOOKUP_READY=true
# BILLTRACK_HOST=
# BILLTRACK_PORT=5432
# BILLTRACK_USER=billtrack_reader
# BILLTRACK_PASSWORD=
# BILLTRACK_DBNAME=postgres
# BILLTRACK_SSLMODE=require
# SELECT con aliases: ref, email, telefono, activo|estado, nombre
# Placeholders: :dni :org_slug :linea
# BILLTRACK_LOOKUP_SQL=SELECT id AS ref, email, telefono, estado AS activo, nombre FROM clientes WHERE dni = :dni LIMIT 1
# GRANT SELECT only — nunca INSERT/UPDATE/DELETE al rol BillTrack.

# ── WhatsApp (opcional) ─────────────────────────────────────────────────────
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=ops-hub-wa-verify
# WHATSAPP_APP_SECRET=
# WHATSAPP_DEFAULT_ORG_SLUG=coop-batan

# ── Frontend ────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_API_URL=https://ibot.ecolan.com
# NEXT_PUBLIC_APP_ENV=production
