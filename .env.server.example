# Plantilla para despliegue NATIVO en Ubuntu 24.04 (IP pública).
# El instalador (scripts/install-server.sh) copia esto a .env si no existe.
#
#   cp .env.server.example .env
#   sudo bash scripts/install-server.sh --public-url http://TU_IP

# ── Identidad pública ───────────────────────────────────────────────────────
PUBLIC_URL=http://TU_IP_PUBLICA
HTTP_PORT=80

# ── PostgreSQL local (Data Estate) ──────────────────────────────────────────
POSTGRES_USER=ops_hub
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_FUERTE
POSTGRES_DB=ops_hub

# El instalador nativo escribe DATABASE_URL automáticamente, por ejemplo:
# DATABASE_URL=postgresql://ops_hub:PASSWORD@127.0.0.1:5432/ops_hub
# DATABASE_SSLMODE=disable

# ── App ─────────────────────────────────────────────────────────────────────
APP_ENV=production
HOST=127.0.0.1
PORT=8000
# DATA_DIR se setea al path del repo/data
AUTH_SECRET=
AUTH_TOKEN_HOURS=72

ADMIN_USER=admin
ADMIN_PASSWORD=CAMBIAR_ADMIN
COOP_USER=coop_prueba
COOP_PASSWORD=CAMBIAR_COOP
COOP_NOMBRE=Operador Prueba
COOP_COOPERATIVA=Cooperativa Prueba

CORS_ORIGINS=http://TU_IP_PUBLICA

# ── LLM en servidor aparte (compatible OpenAI) ──────────────────────────────
# También: Admin Hub → Configuración plataforma → Probar conexión
AI_BASE_URL=http://IP_DEL_SERVIDOR_LLM:11434/v1
AI_API_KEY=ollama
AI_MODEL=llama3.2

# ── BillTrack (opcional) ────────────────────────────────────────────────────
# BILLTRACK_ENABLED=true
# BILLTRACK_HOST=
# BILLTRACK_PORT=5432
# BILLTRACK_USER=billtrack_reader
# BILLTRACK_PASSWORD=
# BILLTRACK_DBNAME=postgres
# BILLTRACK_SSLMODE=disable

# ── WhatsApp (opcional) ─────────────────────────────────────────────────────
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=ops-hub-wa-verify
# WHATSAPP_APP_SECRET=
# WHATSAPP_DEFAULT_ORG_SLUG=coop-batan

# ── Migración desde Supabase (scripts/migrate-data.sh) ──────────────────────
# URI DIRECTA puerto 5432 (no pooler 6543):
# SUPABASE_DATABASE_URL=postgresql://postgres.[ref]:[password]@db.[ref].supabase.co:5432/postgres
